@startuml
'https://plantuml.com/class-diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members



package de
{
    class De
    {
        - _name : String
        - _number : Integer
        - _faces : Integer
        + <<create>> De()
        + <<create>> De(faces : Integer)
        + <<create>> De(number : Integer, faces : Integer)
        + roll() : Integer
        + changeDe(nbDe : Integer, nbFacesDe : Integer)
        + toString() : String
    }
}

package entite
{

    interface Entite <<interface>>
    {
        + {abstract} affichage() : String
    }

    interface Vivant <<interface>>
    {
        + {abstract} setPosition(pos1 : Integer, pos2 : Integer)
        + {abstract} seDeplacer(DJ : Donjon, pos : Integer[2]) : Erreurs
        + {abstract} seFaitAttaquer(degats : Integer, DJ : Donjon) : StatusDonjon
        + {abstract} getStat() : String
        + {abstract} getInfos() : String
        + {abstract} getPetitesInfos() : String
        + {abstract} getInitiative() : Integer
        + {abstract} getPV() : Integer
        + {abstract} getTypeVivant() : TypeVivant
        + {abstract} getPosition() : Integer[2]
        + {abstract} toString() : String
    }

    class Monstre implements Vivant
    {
        - _espece : String
        - _symb : String
        - _numero : Integer
        - _porteeAttaque : Integer
        + <<create>> Monstre(espece : String, symb : String, portAtt : Integer, degAtt : De, charac : De)
        + numeroMonstre()
        + setPosition(pos1 : Integer, pos2 : Integer)
        + seDeplacer(DJ Donjon, pos : Integer[2]) : Erreurs
        + attaquer(DJ Donjon, pers : Personnage) : StatusDonjon
        + seFaitAttaquer(degats : Integer, DJ Donjon) : StatusDonjon

        + getArmorClass() : Integer
        + getStat() : String
        + getInfos() : String
        + getPetitesInfos() : String
        + getPosition() : Integer[2]
        + getInitiative() : Integer
        + getPV() : Integer
        + getNom() : String

        + affichage() : String
        + getTypeVivant() : TypeVivant
        + toString() : String
    }

    class Obstacle implements Entite
    {
        + <<create>> Obstacle
        + setPosition(pos1 : Integer, pos2 : Integer)
        + addPositionDonjon(pos : String, DJ : Donjon)
        + affichage() : String
    }

    package personnages
    {
        package classes
        {
            interface Classe <<interface>>
            {
                + {abstract} getPv() : Integer
                + {abstract} getEquiBase() : Equipement[*]
                + {abstract} getClasse() : String
            }

            class Clerc implements Classe
            {
                - {static} _pv : Integer
                + <<create>> Clerc()
                + getPv() : Integer
                + getEquiBase() : Equipement[*]
                + getClasse() : String
            }

            class Guerrier implements Classe
            {
                - {static} _pv : Integer
                + <<create>> Guerrier()
                + getPv() : Integer
                + getEquiBase() : Equipement[*]
                + getClasse() : String
            }

            class Magicien implements Classe
            {
                - {static} _pv : Integer
                + <<create>> Magicien()
                + getPv() : Integer
                + getEquiBase() : Equipement[*]
                + getClasse() : String
            }

            class Roublard implements Classe
            {
                - {static} _pv : Integer
                + <<create>> Roublard()
                + getPv() : Integer
                + getEquiBase() : Equipement[*]
                + getClasse() : String
            }
        }

        package races
        {
            interface Races <<interface>>
            {
                + {abstract} getStat() : Stats
                + {abstract} getRace() : String
            }

            class Elfes implements Races
            {
                + <<create>> Elfes()
                + getStat() : Stats
                + getRace() : String
            }

            class Halfelins implements Races
            {
                + <<create>> Halfelins()
                + getStat() : Stats
                + getRace() : String
            }

            class Humain implements Races
            {
                + <<create>> Humain()
                + getStat() : Stats
                + getRace() : String
            }

            class Nain implements Races
            {
                + <<create>> Nain()
                + getStat() : Stats
                + getRace() : String
            }
        }

        package genre
        {
            interface Genre <<interface>>
            {
                + {abstract} genrer(mot String) : String
            }

            class Feminin implements Genre
            {
                + genrer(mot String) : String
            }

            class Masculin implements Genre
            {
                + genrer(mot String) : String
            }
        }

        class CreaPerso
        {
            + <<create>> CreaPerso()
            + CreaPers() : Personnage
            + Race()
            + Classe()
            + Genre()
        }

        class Personnage
        {
            - _nom : String
            - _peutRamasser : Boolean

            + <<create>> Personnage(nom : String, race : Races, classe : Classe, genre : Genre)
            + setPosition(pos1 : Integer, pos2 : Integer)
            + seDeplacer(DJ : Donjon, pos : Integer[2]) : Erreurs
            + seDesequiper(equipement : Equipement)
            + sEquiper(equipement : Equipement) : Boolean
            + attaquer(DJ Donjon, mons : Monstre) : StatusDonjon
            + seFaitAttaquer(degats : Integer, DJ Donjon) : StatusDonjon
            + seSoigner(soin : Integer)
            + peutRamasser(equip : Equipement)
            + ramasser(DJ : Donjon)
            + reinilisationRamasser()
            + comAction()
            + regenerationPerso()

            - getArmeEquipe() : Arme
            - getArmureEquipe() : Armure
            + getStock() : Equipement[*]
            + getEquipees() : Equipement[*]
            + getPeutRamEqu() : Equipement
            + getArmorClass() : Integer
            + getEquipeeString() : String
            + getStockString() : String
            + getSorts() : Sort[*]

            + getStat() : String
            + getInfos() : String
            + getPetitesInfos() : String
            + getPosition() : Integer[2]
            + getInitiative() : Integer
            + getPV() : Integer
            + getClasse() : String
            + peutRam() : Boolean
            + getTypeVivant() : TypeVivant

            + affichage() : String
            + toString() : String
        }
    }

    package equipement
    {
        abstract class Equipement <<abstract>>
        {
            - _name : String
            - _speedMalus : Integer
            - _forceBonus : Integer
            + <<create>> Equipement(name : String, typeEqu : TypeEquipement, typeArm : TypeArme, typeArmur : TypeArmure)
            + <<create>> Equipement(name : String, typeEqu : TypeEquipement, typeArm : TypeArme, typeArmur : TypeArmure, speedMalus : Integer)
            + <<create>> Equipement(name : String, typeEqu : TypeEquipement, typeArm : TypeArme, typeArmur : TypeArmure, speedMalus : Integer, forceBonus : Integer)

            + getPosition(pos1 : Integer, pos2 : Integer)
            + getSpeedMalus() : Integer
            + getForceBonus() : Integer
            + getName() : String

            + getTypeEquip() : TypeEquipement
            + getTypeArm() : TypeArme
            + getTypeArmur() : TypeArmure

            + affichage() : String
        }

        package arme
        {
            abstract class Arme <<abstract>>
            {
                - _nbDe : Integer
                - _nbFacesDe : Integer
                - _range : Integer
                + <<create>> Arme(name : String, typeArm : TypeArme, nbDe : Integer, nbFacesDe : Integer, range : Integer)
                + <<create>> Arme(name : String, typeArm : TypeArme, nbDe : Integer, nbFacesDe : Integer, range : Integer, speedMalus : Integer, forceBonus : Integer)
                + bonusMagique()
                + getDegats() : Integer[2]
                + getBonusMagique : Integer
                + getRange() : Integer
                + toString() : String
            }

            package courante
            {
                abstract class ArmeCourante <<abstract>>
                {
                    + <<create>> ArmeCourante(name : String, nbDe : Integer, nbFacesDe : Integer)
                }

                class Baton extends ArmeCourante
                {
                    + <<create>> Baton()
                }

                class MasseArme extends ArmeCourante
                {
                    + <<create>> MasseArme()
                }
            }

            package distance
            {
                abstract class ArmeDistance <<abstract>>
                {
                    + <<create>> ArmeDistance(name : String, nbDe : Integer, nbFacesDe : Integer)
                }

                class ArbaleteLegere extends ArmeDistance
                {
                    + <<create>> ArbaleteLegere()
                }

                class ArcCourt extends ArmeDistance
                {
                    + <<create>> ArcCourt()
                }

                class Fronde extends ArmeDistance
                {
                    + <<create>> Fronde()
                }
            }

            package guerre
            {
                abstract class ArmeGuerre <<abstract>>
                {
                    + <<create>> ArmeGuerre(name : String, nbDe : Integer, nbFacesDe : Integer)
                }

                class EpeeLongue extends ArmeGuerre
                {
                    + <<create>> EpeeLongue()
                }

                class Rapiere extends ArmeGuerre
                {
                    + <<create>> Rapiere()
                }
            }
        }

        package armure
        {
            abstract class Armure <<abstract>>
            {
                - _armorClass : Integer
                + <<create>> Armure(name : String, typeArmur : TypeArmure, armorClass : Integer)
                + <<create>> Armure(name : String, typeArmur : TypeArmure, armorClass : Integer, speedMalus : Integer)
                + getArmorClass() : Integer
                + toString() : String
            }

            package legere
            {
                abstract class ArmureLegere <<abstract>>
                {
                    + <<create>> ArmureLegere(name : String, armorClass : Integer)
                }

                class ArmureEcaille extends ArmureLegere
                {
                    + <<create>> ArmureEcaille()
                }

                class DemiPlate extends ArmureLegere
                {
                    + <<create>> DemiPlate()
                }
            }

            package lourde
            {
                abstract class ArmureLourde
                {
                    + <<create>> ArmureLourde(name : String, armorClass : Integer)
                }

                class CotteMaille extends ArmureLourde
                {
                    + <<create>> CotteMaille()
                }

                class Harnois extends ArmureLourde
                {
                    + <<create>> Harnois()
                }
            }
        }
    }
}


class Tour
{
    - _nbViv : Integer
    + <<create>> Tour(listeVivant : Vivant[*], listePers : Personnage[*], mj : MJ, dj : Donjon)
    + tour()
    + finDonjon()
}

package utils
{
    class MJ
    {
        - _monstreCrees : String[*]

        + <<create>> MJ()

        + creationDonjon(tailleDJ : Integer[2]) : Donjon
        + ajoutObstacle(DJ : Donjon, pos : Integer[2]) : Boolean
        + creationMonstre(espece : String, symb : String, portee : Integer, degAtt : De, charac : De) : Monstre
        + setPositionPerso(DJ : Donjon, perso : Personnage, pos : Integer[2]) : Boolean
        + setPositionMonstre(DJ : Donjon, mons : Monstre, pos : Integer[2]) : Boolean
        + setPositionEquipement(DJ : Donjon, equip : Equipement, pos : Integer[2]) : Boolean

        + presContext()
        + commentaireAction()

        + deplacementVivant(DJ : Donjon, viv : Vivant, posFinale : Integer[2])
        + degatVivant(DJ : Donjon, viv : Vivant, degats : Integer) : StatusDonjon
    }

    class Couleurs
    {
        + <<create>> Couleurs()
        + jaune() : String
        + rouge() : String
        + vert() : String
        + bleu() : String
        + cyan() : String
        + gris() : String
        + reset() : String
    }

    class Inputs
    {
        - {static} _ord : String[26]

        + <<create>> Inputs()

        + creationDonjon(mj : MJ) : Donjon
        + tailleDonjon() : Integer[2]
        + ajoutObstacle(DJ : Donjon, mj : MJ)
        + ajoutMonstre(DJ : Donjon, mj : MJ)
        + ajoutEquipement(DJ : Donjon, mj : MJ)

        + choixCase(context : String) : Integer[2]
        + positionCase(pos : String) : Integer[2]

        + creationMonstre(mj : MJ) : Monstre

        + contextDonjon() : String
        + mjCommenteAction(mj : MJ)
        + persoCommenteAction(perso : Personnage)

        + equiperEquip(pers : Personnage) : Equipement
        + mjDeplaceVivant(dj : Donjon, mj : MJ, listeVivant : Vivant)
        + mjDegatVivant(dj : Donjon, mj : MJ, listeVivant : Vivant) : StatusDonjon
        + infligerDegats() : Integer
    }

    class Actions
    {
        + <<create>> Actions()
        + actionVivant(DJ : Donjon, vivant : Vivant, listeMonstre : Monstre[*], listePersonnage : Personnage[*], listeVivant : Vivant[*]) : StatusDonjon
        + lancerSort(DJ : Donjon, person : Personnage, listePersonnage : Personnage[*], listeVivant : Vivant[*])
        + actionMjFinTour(DJ : Donjon, mj : MJ, listeVivant : Vivant[*]) : StatusDonjon
    }

    class Setup
    {
        - _nbPersonnages : Integer
        - _nbVivants : Integer
        + <<create>> Setup()
        + setupPersonnage() : Personnage[*]
        + setupDonjon(personnages : Personnage[*], tour : Integer) : Donjon
    }

    enum StatusDonjon <<enumerate>>
    {
        NORMAL
        JOUEUR_MORT,
        AUCUN_MONSTRE,
        MONSTRE_MORT,
        ERREUR
    }

    enum Erreurs <<enumerate>>
    {
        VITESSE_SOUS_3
        PROBLEME_CASE,
        TOUT_OK
    }

    enum TypeArme <<enumerate>>
    {
        COURANTE
        DISTANCE,
        GUERRE
    }

    enum TypeArmure <<enumerate>>
    {
        LOURDE
        LEGERE
    }

    enum TypeEquipement <<enumerate>>
    {
        ARME
        ARMURE
    }

    enum TypeVivant <<enumerate>>
    {
        PERSONNAGE
        MONSTRE
    }

}

package donjon
{
    class Donjon
    {
        - _tc1 : Integer
        - _tc2 : Integer

        + <<create>> Donjon(tailleCote : Integer[2])

        + positionObstacle(pc : Integer[2], obst : Obstacle) : Boolean
        + positionVivante(pc : Integer[2], vivant : Vivant) : Boolean
        + positionEquipement(pc : Integer[2], equip : Equipement) : Boolean

        + ramasserEquipement(equip : Equipement)
        + tuerMonstre(mons : Monstre) : StatusDonjon
        + tuerPerso(pers : Personnage) : StatusDonjon
        + switchCase(viv1 : Vivant, viv2 : Vivant)
        + emptyCase(pc : Integer[2])
        + getListeMonstre() : Monstre[*]
        + afficherDJ()
    }

    class AffichDJ
    {
        - _tailleCote1 : Integer
        - _tailleCote2 : Integer
        - _donjon : String[][]
        - {static} _tableauLettres : String[26]
        + <<create>> AffichDJ(tc1 : Integer, tc2 : Integer)
        + remplirDJ(dj : Entite[][])
        + afficherDJ(dj : Entite[][])
    }

    class CreationDonjonDefault
    {
        + <<create>> CreationDonjonDefault
        + creationDonjonDefaut() : Donjon
        + donjonRandom() : Donjon
    }
}

package statistiques
{
    class Position
    {
        - _abscisse : Integer
        - _ordonnee : Integer
        + <<create>> Position()
        + changPos(pos1 : Integer, pos2 : Integer)
        + getAbscisse() : Integer
        + getOrdonnee() : Integer
        + getPosition() : Integer[2]
    }

    class Stats
    {
        - _pointDeVieTot : Integer
        - _pointDeVie : Integer
        - _force : Integer
        - _dexterite : Integer
        - _vitesse : Integer
        - _initiative : Integer
        - _armure : Integer
        + <<create>> Stats()
        + pvt(st : Integer)
        + pv(st : Integer)
        + forc(st : Integer)
        + dex(st : Integer)
        + vit(st : Integer)
        + ini(st : Integer)
        + arm(st : Integer)
        + add(other : Stats)
        + retPvT() : Integer
        + retPv() : Integer
        + retFor() : Integer
        + retDex() : Integer
        + retVit() : Integer
        + retIni() : Integer
        + retArm() : Integer
    }
}

package sort
{
    interface Sort <<interface>>
    {
        + getNom() : String
        + getDescription() : String
    }

    class ArmeMagique implements Sort
    {
        + getNom() : String
        + getDescription() : String
        + lancer(arme : Arme)
    }

    class BoogieWoogie implements Sort
    {
        + getNom() : String
        + getDescription() : String
        + lancer(viv1 : Vivant, viv2 : Vivant, DJ : Donjon)
    }

    class Guerison implements Sort
    {
        + getNom() : String
        + getDescription() : String
        + lancer(perso : Personnage) : Integer
    }
}

Monstre "*" *--> "1\n_degAtt" De : a une puissance d'attaque >
Monstre "*" *--> "1\n_deChar" De : a des caractéristiques >
Monstre "*" *--> "1\n_stats" Stats : a des statistiques >
Monstre "*" *--> "1\n_pos" Position : a une position >

Monstre .> Personnage : <<call/use>>
Monstre .> Donjon : <<call/use>>
Monstre .> Erreurs : <<instantiate>>
Monstre .> StatusDonjon : <<instantiate>>
Monstre .> TypeVivant : <<instantiate>>



Personnage "*" *--> "1\n_race" Races : fait parti de >
Personnage "*" *--> "1\n_classe" Classe : fait parti de >
Personnage "*" *--> "1\n_genre" Genre : a un >
Personnage "*" *--> "1\n_deChar" De : a des caractéristiques >
Personnage "*" *--> "1\n_stats" Stats : a des statistiques >
Personnage "*" *--> "1\n_pos" Position : a une position >
Personnage "*" o--> "1\_equipementARamasser" Equipement : peut ramasser >
Personnage "*" *--> "*\n_stock" Equipement : a dans son inventaire >
Personnage "*" *--> "1\n_equipee" Equipement : est equipé avec >
Personnage "*" *--> "*\n_sorts" Sort : possède >

Personnage .> Monstre : <<call/use>>
Personnage .> Donjon : <<call/use>>
Personnage .> Equipement : <<call/use>>
Personnage .> Erreurs : <<instantiate>>
Personnage .> StatusDonjon : <<instantiate>>
Personnage .> TypeVivant : <<instantiate>>



CreaPerso "*" *--> "1\n_race" Races : le personnage fait parti de >
CreaPerso "*" *--> "1\n_classe" Classe : le personnage fait parti de >
CreaPerso "*" *--> "1\n_genre" Genre : le personnage a un >

CreaPerso .> Personnage : <<instantiate>>
CreaPerso .> Races : <<instantiate>>
CreaPerso .> Classe : <<instantiate>>
CreaPerso .> Genre : <<instantiate>>



Obstacle "*" *--> "1\n_pos" Position : a une position >

Obstacle .> Donjon : <<call/use>>



Equipement "*" *--> "1\n_pos" Position : a une position >
Equipement "*" *--> "1\n_typeEquip" TypeEquipement : à un type >
Equipement "*" *--> "1\n_typeArm" TypeArme : peut avoir un type d'arme >
Equipement "*" *--> "1\n_typeArmur" TypeArmure : peut avoir un type d'armure >




Tour "*" o--> "1\n_listeVivant" Vivant : a une liste de vivants >
Tour "*" o--> "1\n_listePersonnage" Personnage : a une liste de personnages >
Tour "*" *--> "1\n_listeMonstre" Monstre : a une liste de monstres >
Tour "*" o--> "1\n_mj" MJ : a un maitre du jeu >
Tour "*" o--> "1\n_dj" Donjon : a un donjon >
Tour "*" o--> "1\n_statusDonjon" StatusDonjon : a un statut >
Tour "*" *--> "1\n_action" Actions : peut faire des actions >



Donjon "*" *--> "1\n_donjon" Entite : le donjon est composé de >
Donjon "*" *--> "1\n_affDJ" AffichDJ : affiche le donjon >
Donjon "*" *--> "1\n_equip" Equipement : liste des équipements >
Donjon "*" *--> "1\n_pers" Personnage : liste des personnages >
Donjon "*" *--> "1\n_mons" Monstre : liste des monstres >

Donjon .> Vivant : <<call/use>>
Donjon .> Personnage : <<call/use>>
Donjon .> Monstre : <<call/use>>
Donjon .> Obstacle : <<call/use>>
Donjon .> Equipement : <<call/use>>
Donjon .> StatusDonjon : <<instantiate>>



CreationDonjonDefault .> Donjon : <<instantiate/call>>
CreationDonjonDefault .> Monstre : <<instantiate>>
CreationDonjonDefault .> Equipement : <<instantiate>>



MJ .> Donjon : <<use/call>>
MJ .> Personnage : <<use/call>>
MJ .> Vivant : <<use/call>>
MJ .> Equipement : <<use>>
MJ .> Monstre : <<instantiate/use/call>>
MJ .> StatusDonjon : <<instantiate>>



Actions .> Donjon : <<use/call>>
Actions .> Personnage : <<use/call>>
Actions .> Vivant : <<use/call>>
Actions .> Monstre : <<use/call>>
Actions .> MJ : <<use/call>>



